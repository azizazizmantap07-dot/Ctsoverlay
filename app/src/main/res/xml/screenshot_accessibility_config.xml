<?xml version="1.0" encoding="utf-8"?>
<!--
    Konfigurasi minimal: tidak butuh event, tidak butuh retrieve window content.
    Hanya dipakai agar AccessibilityService#takeScreenshot tersedia (API 30+).
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="false"
    android:canTakeScreenshot="true"
    android:description="@string/a11y_screenshot_desc"
    android:settingsActivity="com.israfilx.circlesearch.ui.MainActivity" />
